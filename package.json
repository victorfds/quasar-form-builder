{
  "name": "nuxt-quasar-form-builder",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@12.11.2",
  "description": "Nuxt module that provides a Quasar and FormKit based form builder.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./media": {
      "types": "./dist/runtime/app/media/index.d.ts",
      "import": "./dist/runtime/app/media/index.js"
    },
    "./schema": {
      "types": "./dist/runtime/app/schema/index.d.ts",
      "import": "./dist/runtime/app/schema/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist",
    "docs"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxi dev .playground",
    "dev:prepare": "nuxt-module-build build --stub . && nuxi prepare .playground",
    "build:module": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "build": "nuxt build .playground",
    "generate": "nuxt generate .playground",
    "preview": "nuxt preview .playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --project=chromium --project=firefox --grep @smoke --output=.tmp/test-results-local",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json && vue-tsc --noEmit -p tsconfig.servercheck.json",
    "typecheck:sdk": "node scripts/typecheck-sdk.mjs",
    "test:toolchain": "node scripts/test-toolchain.mjs",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --profile=full",
    "check:local:steps": "pnpm dev:prepare && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:toolchain && pnpm build:module && pnpm typecheck:sdk && pnpm test:e2e:local",
    "check:native": "node scripts/check.mjs --browsers=native",
    "check:docker": "node scripts/check.mjs --browsers=docker",
    "check:steps": "pnpm dev:prepare && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:toolchain && pnpm build:module && pnpm typecheck:sdk && pnpm build && pnpm test:e2e && pnpm test:consumer && pnpm audit:check",
    "audit:check": "node scripts/check-audit.mjs",
    "test:consumer": "node scripts/test-consumers.mjs"
  },
  "peerDependencies": {
    "nuxt": ">=4.5.1 <5",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@formkit/core": "^2.1.2",
    "@formkit/i18n": "^2.1.2",
    "@formkit/utils": "^2.1.2",
    "@formkit/vue": "^2.1.2",
    "@nuxt/kit": "^4.6.1",
    "@pinia/nuxt": "^1.0.2",
    "@quasar/extras": "^2.1.0",
    "defu": "^6.1.7",
    "idb": "^8.0.4",
    "jsep": "^1.6.0",
    "nuxt-quasar-ui": "^3.1.2",
    "quasar": "^2.35.1",
    "shiki": "^4.5.0",
    "std-env": "^4.3.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.1",
    "pinia": "^4.0.3",
    "sass": "^1.105.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
